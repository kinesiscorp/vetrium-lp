# Postgres (dev local via docker-compose, produção via Coolify - rede interna, sem porta pública)
DATABASE_URL="postgresql://vetriumcrm:vetriumcrm@localhost:5434/vetriumcrm?schema=public"

# NextAuth - gerar com: openssl rand -base64 32
AUTH_SECRET=""

# Diretório de upload dos materiais (produção precisa de volume persistente montado aqui)
UPLOAD_DIR="./uploads"

# true só no primeiro deploy contra um Postgres limpo (cria o usuário admin e migra os
# clientes/leads iniciais) - depois volta pra false. Idempotente (upsert), mas evita
# reprocessar toda vez que o container reinicia.
RUN_SEED="false"
